{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "2.0.0",
    "tasks": [
        {
            // Вычисляет адрес Windows-хоста из WSL2 и прописывает OLLAMA_URL
            // в backend/.env. Запускается автоматически через preLaunchTask
            // в конфиге "Python Debugger: FastAPI"; для "Celery Worker"
            // достаточно добавить такую же строку preLaunchTask.
            "label": "wsl: refresh backend/.env",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/wsl-host-env.sh"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        }
    ]
}
